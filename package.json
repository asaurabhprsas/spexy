{
  "name": "spexy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.0.9",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "skills/*"
  ],
  "scripts": {
    "build": "pnpm run build:ui && pnpm run build:cli",
    "build:ui": "pnpm --filter @workspace/spexy run build",
    "build:cli": "node ./node_modules/tsx/dist/cli.mjs ./scripts/build-cli.ts",
    "typecheck": "tsc --noEmit && tsc -p packages/ui/tsconfig.json --noEmit",
    "publish:local": "node ./node_modules/tsx/dist/cli.mjs ./scripts/publish-local.ts",
    "local:publish": "node ./node_modules/tsx/dist/cli.mjs ./scripts/publish-local.ts",
    "link:skills": "node ./scripts/link-skills.ts",
    "prepare": "node ./scripts/link-skills.ts && husky",
    "test": "vitest run",
    "release": "node ./node_modules/tsx/dist/cli.mjs ./scripts/release.ts",
    "release:check": "pnpm run typecheck && pnpm test && pnpm run build && node ./packages/cli/dist/bin.js doctor --compact",
    "release:pack": "cd packages/cli && npm pack --dry-run",
    "release:alpha": "node ./node_modules/tsx/dist/cli.mjs ./scripts/release.ts alpha --publish",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "chokidar": "^4.0.3",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.6",
    "tsx": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.7.0",
    "zod": "catalog:"
  }
}
